.custom-label {
    font-size: 20px;
    -unity-font-style: bold;
    color: rgb(68, 138, 255);
}

.button:hover {
    scale: 1.1 1.1;
    transition-duration: 0.25s;
}

.button:active {
    scale: 0.9 0.9;
    transition-duration: 0.25s;
}



VisualElement > VisualElement > VisualElement > #monster-group > VisualElement > #unique-move-toggle > .unity-toggle__input {
    flex-direction: row-reverse;
}

VisualElement > VisualElement > VisualElement > #card-dropdown > .unity-popup-field__input {
    width: 200px;
}



VisualElement > VisualElement > VisualElement > #card-dropdown > .unity-popup-field__label {
    margin-right: -75px;
}
